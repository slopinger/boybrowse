{
  "manifest_version": 3,
  "name": "Boybrowse Shields",
  "version": "0.1.0",
  "description": "Boybrowse third-party advertising and tracker request filtering.",
  "key": "",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "starter",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
